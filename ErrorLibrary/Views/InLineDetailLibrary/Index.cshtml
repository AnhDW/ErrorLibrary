@{
    ViewData["Title"] = "In line detail";
}
<!-- Content wrapper -->
<div class="content-wrapper">
    <!-- Content -->

    <div class="container-xxl flex-grow-1 container-p-y">
        <div id="formWrapper" class="mb-2">
            <div class="form-grid">
                <div class="form-item">
                    <label>Chuyền</label>
                    <div class="dropdown w-100" data-bs-auto-close="false">
                        <button class="btn btn-light dropdown-toggle w-100"
                                type="button"
                                id="btnTreeOrganization"
                                data-bs-toggle="dropdown">
                            Chọn chuyền
                        </button>

                        <ul class="dropdown-menu w-100" aria-labelledby="btnTreeOrganization">
                            <li><div id="treeOrganization"></div></li>
                        </ul>
                    </div>
                    <input type="hidden" id="selectedOrganizationNode" name="Organization" />
                </div>

                <div class="form-item">
                    <label for="selectProductCode">Mã hàng</label>
                    <select id="selectProductCode" class="form-select">
                        <option selected="">Chọn mã hàng</option>
                        <option value="A1">ABC123</option>
                        <option value="A2">JKL432</option>
                        <option value="A3">UIO12</option>
                    </select>
                </div>

                <div class="form-item">
                    <label for="date">Ngày</label>
                    <input id="date" class="form-control" type="date" disabled>
                </div>

                <div class="form-item">
                    <label for="quantity">Số lượng kiểm</label>
                    <input id="quantity" class="form-control" type="number" value="0">
                </div>

                <div class="form-item">
                    <label for="user">Người kiểm</label>
                    <input id="user" class="form-control" type="text" value="itsc" disabled>
                </div>
            </div>
        </div>
        
        <button id="toggleFormBtn" class="toggle-btn w-100" style="border:none; border-radius:0 0 0 0;">
            <i class="fas fa-angle-double-up"></i>
        </button>

        <div class="row mt-3" id="timeFrameCard">
            
        </div>
        @*<div class="d-flex justify-content-center">
            <a asp-controller="TimeFrameLibrary"><i class="fas fa-arrow-right"></i> Cài đặt khung thời gian</a>
        </div> *@
        <div class="mt-1">
            <!-- Add Modal -->
            <div class="modal fade" id="addModel" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Thêm kiểm InLine</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
                            <div class="modal-body">
                                <input id="timeFrameId" type="text" class="form-control" hidden>

                                <div class="mb-2">
                                    <label for="selectedErrorGroup" class="form-label">Chọn nhóm lỗi</label>
                                    <select class="form-select" id="selectedErrorGroup" aria-label="Default select example">
                                        <option selected="">Chọn nhóm lỗi </option>
                                        <option value="A1">Nhóm lỗi 1</option>
                                        <option value="A2">Nhóm lỗi 2</option>
                                        <option value="A3">Nhóm lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="selectedError" class="form-label">Chọn lỗi</label>
                                    <select class="form-select" id="selectedError" aria-label="Default select example" disabled>
                                        <option selected="">Chọn lỗi </option>
                                        <option value="A1">Lỗi 1</option>
                                        <option value="A2">Lỗi 2</option>
                                        <option value="A3">Lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="quantityInLine" class="form-label">Số lượng</label>
                                    <div class="input-group">
                                        <button class="btn btn-outline-primary fs-5" type="button" id="addBtnDecreases">-</button>
                                        <input id="quantityInLine" type="number" class="form-control" value="0" min="0">
                                        <button class="btn btn-outline-primary fs-5" type="button" id="addBtnIncreases">+</button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="handleAddInLineDetail()">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Edit Modal -->
            <div class="modal fade" id="editModel" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Thêm kiểm InLine</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
                            <div class="modal-body">
                                <input id="editInLineDetailId" type="text" class="form-control" hidden>
                                <input id="editInLineId" type="text" class="form-control" hidden>
                                <input id="editTimeFrameId" type="text" class="form-control" hidden>
                                <input id="editCreateAt" type="text" class="form-control" hidden>

                                <div class="mb-2">
                                    <label for="editSelectedErrorGroup" class="form-label">Chọn nhóm lỗi</label>
                                    <select class="form-select" id="editSelectedErrorGroup" aria-label="Default select example">
                                        <option selected="">Chọn nhóm lỗi </option>
                                        <option value="A1">Nhóm lỗi 1</option>
                                        <option value="A2">Nhóm lỗi 2</option>
                                        <option value="A3">Nhóm lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="editSelectedError" class="form-label">Chọn lỗi</label>
                                    <select class="form-select" id="editSelectedError" aria-label="Default select example">
                                        <option selected="">Chọn lỗi </option>
                                        <option value="A1">Lỗi 1</option>
                                        <option value="A2">Lỗi 2</option>
                                        <option value="A3">Lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="editQuantityInLine" class="form-label">Số lượng</label>
                                    <div class="input-group">
                                        <button class="btn btn-outline-primary fs-5" type="button" id="editBtnDecreases">-</button>
                                        <input id="editQuantityInLine" type="number" class="form-control" value="0" min="0">
                                        <button class="btn btn-outline-primary fs-5" type="button" id="editBtnIncreases">+</button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="handleEditInLineDetail()">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- Striped Rows -->
        <div class="card mt-4">
            <div style="min-height:200px;" class="table-responsive text-nowrap">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Khung giờ</th>
                            <th>Giờ</th>
                            <th>Công đoạn</th>
                            <th>Mã lỗi</th>
                            <th>Tên lỗi</th>
                            <th>Số lượng lỗi</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="inLineDetailTableBody" class="table-border-bottom-0">
                    </tbody>
                </table>
            </div>
        </div>
        <!--/ Striped Rows -->
    </div>
    <!-- / Content -->
    <div class="content-backdrop fade"></div>
</div>
<style>
    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 12px 20px; /* khoảng cách giữa các ô */
        margin-top: 10px;
    }

    .form-item {
        display: flex;
        flex-direction: column;
    }

    .form-item label {
        margin-bottom: 4px;
        font-weight: 600;
    }
    .toggle-btn {
        width: 100%;
        height: 32px; /* Thấp hơn */
        border: none;
        background: none; /* Màu nhẹ */
        display: flex;
        align-items: center;
        justify-content: center; /* Icon ở giữa */
        cursor: pointer;
        border-radius: 6px;
        transition: background 0.2s ease;
    }

    .toggle-btn:hover {
        background: #e0e0e0;
    }

    .toggle-btn span {
        font-size: 18px;
        transition: transform 0.2s ease;
    }
    @@media (min-width: 768px) and (max-width: 1024px) {
        .form-grid {
            grid-template-columns: repeat(5, 1fr);
        }
    }
</style>
<!-- Content wrapper -->
@section Scripts {
    <script src="~/js/page-handle/in-line-detail-library.js"></script>
    <script src="~/js/request/in-line-request.js"></script>
    <script src="~/js/request/in-line-detail-request.js"></script>
    <script src="~/js/request/time-frame-request.js"></script>
    <script src="~/js/request/time-frame-color-request.js"></script>
    <script src="~/js/request/organization-request.js"></script>
    <script src="~/js/request/user-organization-request.js"></script>
    <script src="~/js/request/product-request.js"></script>
    <script src="~/js/request/error-group-request.js"></script>
    <script src="~/js/request/error-request.js"></script>
    <script src="~/js/request/user-request.js"></script>
    <script src="~/js/share/shared-service.js"></script>
    <script src="~/js/share/tree-view-select.js"></script>
}
