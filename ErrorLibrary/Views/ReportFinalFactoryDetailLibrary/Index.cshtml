@{
    ViewData["Title"] = "Report final factory";
}

<div class="content-wrapper">
    <!-- Content -->

    <div class="container-xxl flex-grow-1 container-p-y">
        <div id="formWrapper" class="mb-2">
            <div class="form-grid">
                <div class="form-item">
                    <label>Nhà máy</label>
                    <div class="d-flex align-items-center" id="factoryDropdown"></div>
                </div>
                <div class="form-item">
                    <label for="date">Ngày</label>
                    <input id="date" class="form-control" type="date">
                </div>
            </div>
        </div>
        
        <button id="toggleFormBtn" class="toggle-btn w-100" style="border:none; border-radius:0 0 0 0;">
            <i class="fas fa-angle-double-up"></i>
        </button>

        <div class="d-flex flex-wrap justify-content-between p-2">
            <div>
                @* <label class="text-black">Số lượng đạt: </label>
                <h3 class="m-0 text-info" id="txtAcceptedQuantity"><span class="text-success">0</span>/0</h3> *@
            </div>
            <div>
                @* <label class="text-black">Trạng thái: </label>
                <h3 class="m-0 text-info" id="txtErrorQuantity"><span class="text-danger">0</span>/0</h3> *@
            </div>
            <div>
                @* <label></label>
                <div class="d-flex flex-row-reverse gap-1">
                    <button id="btnIsFinalized" class="btn btn-secondary btn-sm" type="button"><i class="fas fa-check"></i>Hoàn thành</button>
                    <button id="btnIsActive" class="btn btn-secondary btn-sm" type="button"><i class="fas fa-times"></i>Hủy kiểm</button>
                </div> *@
            </div>
        </div>

        <div class="row mt-3" id="timeFrameCard">
        </div>
        @*<div class="d-flex justify-content-center">
            <a asp-controller="TimeFrameLibrary"><i class="fas fa-arrow-right"></i> Cài đặt khung thời gian</a>
        </div> *@
        <div class="mt-1">
            <button type="button" class="btn rounded-pill btn-primary" onclick="addReportFinalFactoryDetail()">
                <span class="tf-icons bx bx-plus"></span>&nbsp; Thêm
            </button>
            <button type="button" class="btn rounded-pill ui-bg-overlay" data-bs-toggle="modal"
                    data-bs-target="#importModel" onclick="showImportModel()">
                <i class="bx bx-import"></i>
            </button>
            <!-- Import Modal -->
            <div class="modal fade" id="importModel" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered " role="document">

                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Import</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
                            <div class="modal-body">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="onDownloadForm()">
                                    <i class="fas fa-file-download"></i>Tải form mẫu
                                </button>
                                <div class="row">
                                    <div class="mb-2 col-md-6">
                                        <label for="importReportFinalFactories" class="form-label">Chọn file</label>
                                        <input class="form-control" type="file" id="importReportFinalFactories">
                                    </div>
                                    <div class="mb-2 col-md-6">
                                        <label for="sheetSelect" class="form-label">Work sheet</label>
                                        <select class="form-select" id="sheetSelect" aria-label="Default select example">
                                            <option selected="">Chọn work sheet</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="importErrorsExcel()"><i class="fas fa-file-upload"></i>Tải lên</button>
                            </div>
                        </form>
                        <div id="preview" class="p-2"></div>
                    </div>
                </div>
            </div>
            <!-- Add Modal -->
            @* <div class="modal fade" id="addModel" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Thêm kiểm InLine</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
