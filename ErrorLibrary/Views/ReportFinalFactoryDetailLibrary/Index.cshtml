                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="handleAddInLineDetail()">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div> *@
            <!-- Add Modal 1 -->
            <div class="modal fade" id="addModel1" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Thêm kiểm InLine</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
                            <div class="modal-body">
                                <input id="timeFrameId" type="text" class="form-control" hidden>
                                <input id="errorId" type="text" class="form-control" hidden>

                                <div class="mb-2">
                                    <label class="form-label">Nhóm lỗi</label>
                                    <div id="errorGroupList" class="d-flex flex-wrap gap-2">
                                        <button type="button" class="btn btn-outline-primary error-group" data-id="A1">Nhóm lỗi 1</button>
                                        <button type="button" class="btn btn-outline-primary error-group" data-id="A2">Nhóm lỗi 2</button>
                                        <button type="button" class="btn btn-outline-primary error-group" data-id="A3">Nhóm lỗi 3</button>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">Lỗi</label>
                                    <div id="errorList" class="d-flex flex-wrap gap-2">
                                        <!-- render động -->
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label for="quantityInLine" class="form-label">Số lượng</label>
                                    <div class="input-group">
                                        <button class="btn btn-outline-primary fs-5" type="button" id="addBtnDecreases">-</button>
                                        <input id="quantityInLine" type="number" class="form-control" value="1" min="0">
                                        <button class="btn btn-outline-primary fs-5" type="button" id="addBtnIncreases">+</button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="handleAddInLineDetail()">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Edit Modal -->
            <div class="modal fade" id="editModel" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Thêm kiểm InLine</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
                            <div class="modal-body">
                                <input id="editInLineDetailId" type="text" class="form-control" hidden>
                                <input id="editInLineId" type="text" class="form-control" hidden>
                                <input id="editTimeFrameId" type="text" class="form-control" hidden>
                                <input id="editCreateAt" type="text" class="form-control" hidden>

                                <div class="mb-2">
                                    <label for="editSelectedErrorGroup" class="form-label">Chọn nhóm lỗi</label>
                                    <select class="form-select" id="editSelectedErrorGroup" aria-label="Default select example">
                                        <option selected="">Chọn nhóm lỗi </option>
                                        <option value="A1">Nhóm lỗi 1</option>
                                        <option value="A2">Nhóm lỗi 2</option>
                                        <option value="A3">Nhóm lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="editSelectedError" class="form-label">Chọn lỗi</label>
                                    <select class="form-select" id="editSelectedError" aria-label="Default select example">
                                        <option selected="">Chọn lỗi </option>
                                        <option value="A1">Lỗi 1</option>
                                        <option value="A2">Lỗi 2</option>
                                        <option value="A3">Lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="editQuantityInLine" class="form-label">Số lượng</label>
                                    <div class="input-group">
                                        <button class="btn btn-outline-primary fs-5" type="button" id="editBtnDecreases">-</button>
                                        <input id="editQuantityInLine" type="number" class="form-control" value="0" min="0">
                                        <button class="btn btn-outline-primary fs-5" type="button" id="editBtnIncreases">+</button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="handleEditInLineDetail()">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- Striped Rows -->
        <div class="card mt-4">
            <div style="min-height:200px;" class="table-responsive text-nowrap">
                <div id="reportFinalFactoryDetailGrid" style="height: 500px"></div>
            </div>
        </div>
        <!--/ Striped Rows -->
    </div>
    <!-- / Content -->
    <div class="content-backdrop fade"></div>
</div>
<style>
    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 12px 20px; /* khoảng cách giữa các ô */
        margin-top: 10px;
    }

    .form-item {
        display: flex;
        flex-direction: column;
    }

        .form-item label {
            margin-bottom: 4px;
            font-weight: 600;
        }

    .toggle-btn {
        width: 100%;
        height: 32px; /* Thấp hơn */
        border: none;
        background: none; /* Màu nhẹ */
        display: flex;
        align-items: center;
        justify-content: center; /* Icon ở giữa */
        cursor: pointer;
        border-radius: 6px;
        transition: background 0.2s ease;
    }

        .toggle-btn:hover {
            background: #e0e0e0;
        }

        .toggle-btn span {
            font-size: 18px;
            transition: transform 0.2s ease;
        }

</style>
@section Scripts {
    <script src="~/js/page-handle/report-final-factory-detail-library.js"></script>
    <script src="~/js/request/report-final-factory-detail-defects-request.js"></script>
    <script src="~/js/request/report-final-factory-detail-request.js"></script>
    <script src="~/js/request/report-final-factory-request.js"></script>
    <script src="~/js/request/organization-request.js"></script>
    <script src="~/js/request/defect-request.js"></script>
}