        // ['Khách hàng/ Mã hàng', 'PO', 'Số lượng','Pre-final', '', 'Ngày kiểm lần 1', 'Kết quả kiểm lần 1',  'Ngày kiểm lần 2', 'Kết quả kiểm lần 2'],
