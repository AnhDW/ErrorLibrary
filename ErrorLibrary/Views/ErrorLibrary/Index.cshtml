@model List<ErrorDto>
@{
    ViewData["Title"] = "Thư viện lỗi";
}
<!-- Content wrapper -->
<div class="content-wrapper">
    <!-- Content -->

    <div class="container-xxl flex-grow-1 container-p-y">
        <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Thư viện lỗi</span></h4>
        <div>
            <button type="button" class="btn rounded-pill btn-primary" data-bs-toggle="modal"
                    data-bs-target="#addModel" onclick="addShowErrorModalHandle()">
                <span class="tf-icons bx bx-plus"></span>&nbsp; Thêm
            </button>

            <button type="button" class="btn rounded-pill ui-bg-overlay" data-bs-toggle="modal"
                    data-bs-target="#importModel">
                <i class="bx bx-import"></i>
            </button>
            <!-- Import Modal -->
            <div class="modal fade" id="importModel" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered " role="document">

                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Import</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
                            <div class="modal-body">
                                <div class="row">
                                    <div class="mb-2 col-md-6">
                                        <label for="importErrors" class="form-label">Chọn file</label>
                                        <input class="form-control" type="file" id="importErrors">
                                    </div>
                                    <div class="mb-2 col-md-6">
                                        <label for="sheetSelect" class="form-label">Work sheet</label>
                                        <select class="form-select" id="sheetSelect" aria-label="Default select example">
                                            <option selected="">Chọn work sheet</option>
                                            <option value="1">Work sheet 1</option>
                                            <option value="2">Work sheet 2</option>
                                            <option value="3">Work sheet 3</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="importErrorsExcel()">Import</button>
                            </div>
                        </form>
                        <div id="preview" ></div>
                    </div>
                </div>
            </div>
            <!-- Add Modal -->
            <div class="modal fade" id="addModel" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Thêm lỗi</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
                            <div class="modal-body">
                                <div class="mb-2">
                                    <label for="addErrorGroupSelect" class="form-label">Nhóm lỗi</label>
                                    <select class="form-select" id="addErrorGroupSelect" aria-label="Default select example">
                                        <option selected="">Chọn nhóm lỗi</option>
                                        <option value="1">Nhóm lỗi 1</option>
                                        <option value="2">Nhóm lỗi 2</option>
                                        <option value="3">Nhóm lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="addErrorCategorySelect" class="form-label">Loại lỗi</label>
                                    <select class="form-select" id="addErrorCategorySelect" aria-label="Default select example">
                                        <option selected="">Chọn chủng loại lỗi</option>
                                        <option value="1">Loại lỗi 1</option>
                                        <option value="1">Loại lỗi 2</option>
                                        <option value="1">Loại lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="addProductCategorySelect" class="form-label">Chủng loại sản phẩm</label>
                                    <select class="form-select" id="addProductCategorySelect" aria-label="Default select example">
                                        <option selected="">Chọn chủng loại sản phẩm</option>
                                        <option value="1">Chủng loại sản phẩm 1</option>
                                        <option value="2">Chủng loại sản phẩm 2</option>
                                        <option value="3">Chủng loại sản phẩm 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="addErrorCode" class="form-label">Mã lỗi</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="addErrorCode" placeholder="Nhập mã lỗi">
                                        <button type="button" class="btn btn-outline-secondary" onclick="setAddErrorCode()">Tạo mã tự động</button>
                                    </div>
                                    <small class="form-text text-muted">
                                        Mã lỗi sẽ tự sinh theo <span class="text-primary">( mã nhóm lỗi + thứ tự lỗi )</span> A1, A2, … , B1, … , C1, …
                                    </small>
                                </div>
                                <div class="mb-2">
                                    <label for="addErrorName" class="form-label">Tên lỗi</label>
                                    <input type="text" class="form-control" id="addErrorName" placeholder="Nhập tên lỗi" aria-describedby="defaultFormControlHelp">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="handleAddError()">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Edit Modal -->
            <div class="modal fade" id="editModel" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCenterTitle">Sửa lỗi</h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <form action="/" method="post">
                            <div class="modal-body">
                                <div class="mb-2">
                                    <label for="editErrorGroupSelect" class="form-label">Nhóm lỗi</label>
                                    <select class="form-select" id="editErrorGroupSelect" aria-label="Default select example">
                                        <option selected="">Chọn nhóm lỗi</option>
                                        <option value="1">Nhóm lỗi 1</option>
                                        <option value="2">Nhóm lỗi 2</option>
                                        <option value="3">Nhóm lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="editErrorCategorySelect" class="form-label">Loại lỗi</label>
                                    <select class="form-select" id="editErrorCategorySelect" aria-label="Default select example">
                                        <option selected="">Chọn chủng loại lỗi</option>
                                        <option value="1">Loại lỗi 1</option>
                                        <option value="1">Loại lỗi 2</option>
                                        <option value="1">Loại lỗi 3</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label for="editProductCategorySelect" class="form-label">Chủng loại sản phẩm</label>
                                    <select class="form-select" id="editProductCategorySelect" aria-label="Default select example">
                                        <option selected="">Chọn chủng loại sản phẩm</option>
                                        <option value="1">Chủng loại sản phẩm 1</option>
                                        <option value="2">Chủng loại sản phẩm 2</option>
                                        <option value="3">Chủng loại sản phẩm 3</option>
                                    </select>
                                </div>
                                <input type="text" class="form-control" id="editErrorId" placeholder="ID" aria-describedby="defaultFormControlHelp" hidden>

                                <div class="mb-2">
                                    <label for="editErrorCode" class="form-label">Mã lỗi</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="editErrorCode" placeholder="Nhập mã lỗi">
                                        <button type="button" class="btn btn-outline-secondary" onclick="setEditErrorCode()">Tạo mã tự động</button>
                                    </div>
                                    <small class="form-text text-muted">
                                        Mã lỗi sẽ tự sinh theo <span class="text-primary">( mã nhóm lỗi + thứ tự lỗi )</span> A1, A2, … , B1, … , C1, …
                                    </small>
                                </div>
                                <div class="mb-2">
                                    <label for="editErrorName" class="form-label">Tên lỗi</label>
                                    <input type="text" class="form-control" id="editErrorName" placeholder="Nhập tên lỗi" aria-describedby="defaultFormControlHelp">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                                <button type="button" class="btn btn-primary" onclick="handleEditError()">Lưu</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- Striped Rows -->
        <div class="card mt-4">
            <div style="min-height:200px;max-height:500px;" class="table-responsive text-nowrap scrollspy-example">
                <table id="errorTable" class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nhóm lỗi</th>
                            <th>Loại lỗi</th>
                            <th>Chủng loại sản phẩm</th>
                            <th>Mã lỗi</th>
                            <th>Tên lỗi</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="errorTableBody" class="table-border-bottom-0" style="">
                    </tbody>
                </table>
            </div>
            <!-- UI PAGINATION -->
            <nav aria-label="Page navigation" class="mt-3">
                <ul class="pagination justify-content-center" id="errorPagination"></ul>
            </nav>
        </div>
        <!--/ Striped Rows -->
    </div>
    <!-- / Content -->
    <div class="content-backdrop fade"></div>
</div>
<!-- Content wrapper -->

@section Scripts {
    <script src="~/js/page-handle/error-library.js"></script>
    <script src="~/js/request/error-request.js"></script>
    <script src="~/js/request/error-group-request.js"></script>
    <script src="~/js/request/error-category-request.js"></script>
    <script src="~/js/request/product-category-request.js"></script>
    <script src="~/js/signal-r/error-hub.js"></script>

}