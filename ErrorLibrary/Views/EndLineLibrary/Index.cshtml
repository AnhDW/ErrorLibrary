            </div>
        </div> *@
        <!-- Striped Rows -->
        <div class="card mt-4">
            <div style="min-height:200px;" class="table-responsive text-nowrap">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Mã sản phẩm</th>
                            <th>Số lượng đơn hàng</th>
                            <th>Số lượng kiểm</th>
                            <th>Số lượng đạt</th>
                            <th>Số lượng lỗi</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="endLineTableBody" class="table-border-bottom-0">
                    </tbody>
                </table>
            </div>
        </div>
        <!--/ Striped Rows -->
    </div>
    <!-- / Content -->
    <div class="content-backdrop fade"></div>
</div>
<style>
    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 12px 20px; /* khoảng cách giữa các ô */
        margin-top: 10px;
    }

    .form-item {
        display: flex;
        flex-direction: column;
    }

        .form-item label {
            margin-bottom: 4px;
            font-weight: 600;
        }

    .toggle-btn {
        width: 100%;
        height: 32px; /* Thấp hơn */
        border: none;
        background: none; /* Màu nhẹ */
        display: flex;
        align-items: center;
        justify-content: center; /* Icon ở giữa */
        cursor: pointer;
        border-radius: 6px;
        transition: background 0.2s ease;
    }

    .toggle-btn:hover {
        background: #e0e0e0;
    }

    .toggle-btn span {
        font-size: 18px;
        transition: transform 0.2s ease;
    }

</style>
<!-- Content wrapper -->
@section Scripts {
    <script src="~/js/page-handle/end-line-library.js"></script>
    <script src="~/js/request/end-line-request.js"></script>
    <script src="~/js/request/organization-request.js"></script>
    <script src="~/js/request/user-organization-request.js"></script>
    <script src="~/js/share/tree-view-select.js"></script>
}

